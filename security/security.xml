<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record Rules for Visit Tracking Access Control -->

    <!-- Project users can only see their own check-ins -->
    <record id="visit_tracker_rule_own_records" model="ir.rule">
        <field name="name">Field Check-in: Own Records Only</field>
        <field name="model_id" ref="model_visit_tracker"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Project managers can see all check-ins -->
    <record id="visit_tracker_rule_manager_all" model="ir.rule">
        <field name="name">Field Check-in: Managers See All</field>
        <field name="model_id" ref="model_visit_tracker"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Visit Report: Project users see only their own rows -->
    <record id="visit_report_rule_user_own" model="ir.rule">
        <field name="name">Visit Report: User Own + Unassigned Only</field>
        <field name="model_id" ref="model_visit_report"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="True"/>
    </record>

    <!-- Visit Report: Managers see everything -->
    <record id="visit_report_rule_manager_all" model="ir.rule">
        <field name="name">Visit Report: Manager See All</field>
        <field name="model_id" ref="model_visit_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="perm_read" eval="True"/>
    </record>

    <!-- Visit Plan rules -->
    <record id="visit_plan_rule_own" model="ir.rule">
        <field name="name">Visit Plan: Own Plans</field>
        <field name="model_id" ref="model_visit_plan"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="visit_plan_rule_manager_all" model="ir.rule">
        <field name="name">Visit Plan: Managers Manage All</field>
        <field name="model_id" ref="model_visit_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="visit_plan_line_rule_own" model="ir.rule">
        <field name="name">Visit Plan Stops: Own Plans (Read)</field>
        <field name="model_id" ref="model_visit_plan_line"/>
        <field name="domain_force">[('plan_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="visit_plan_line_rule_own_manage_draft" model="ir.rule">
        <field name="name">Visit Plan Stops: Own Draft Plans (Manage)</field>
        <field name="model_id" ref="model_visit_plan_line"/>
        <field name="domain_force">[('plan_id.user_id', '=', user.id), ('plan_id.state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="visit_plan_line_rule_manager_all" model="ir.rule">
        <field name="name">Visit Plan Stops: Managers Manage All</field>
        <field name="model_id" ref="model_visit_plan_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
